# --- Meta / WhatsApp Cloud API ---
# From Meta Business Suite > WhatsApp > API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Any string you make up yourself - used to verify the webhook with Meta
VERIFY_TOKEN=landnest_verify_2026

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Human handoff ---
# WhatsApp number (with country code, no +, no spaces) that gets notified when the
# agent can't confidently answer or a lead asks for a human. Example: 2348012345678
HANDOFF_NUMBER=

# --- Admin endpoints ---
# Protects /admin/refresh-website, /admin/upload-faq, /admin/reparse-faqs,
# /admin/knowledge-preview. Make up any long random string.
ADMIN_SECRET=

# --- Server ---
PORT=3000
